{
  "name": "@threadify/sdk",
  "version": "0.2.0",
  "description": "JavaScript SDK for Threadify - Execute business process graphs with context\u2014track what happened, validate every step, and trigger context-aware actions",
  "main": "dist/index.cjs",
  "module": "src/index.js",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "node scripts/build-cjs.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:refs": "npm run build && node --test tests/ref-query.test.js",
    "test:connection-errors": "node --test tests/connection-errors.test.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules npx jest --watch",
    "prepublishOnly": "npm test",
    "publish:dry": "npm pack --dry-run",
    "publish:beta": "npm publish --tag beta",
    "test:package": "node scripts/test-package.js"
  },
  "keywords": [
    "service-delivery",
    "workflow-cordination",
    "business-process",
    "threadify",
    "threadify.dev",
    "threadify-dev",
    "distributed tracing",
    "service-delivery-intelligence"
  ],
  "author": "Threadify Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "src/",
    "dist/",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreadifyDev/node-sdk.git"
  },
  "homepage": "https://github.com/ThreadifyDev/node-sdk",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
